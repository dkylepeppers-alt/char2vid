{
  "name": "char2vid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @char2vid/studio",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages,tests}/**/*.{ts,tsx,css,html,json}\" \".github/**/*.{yml,json,md}\" \"scripts/**/*.mjs\" \"{AGENTS,README}.md\" \"docs/{development,validation}/**/*.md\" \"*.{json,js,mjs,ts}\"",
    "format:check": "prettier --check \"{apps,packages,tests}/**/*.{ts,tsx,css,html,json}\" \".github/**/*.{yml,json,md}\" \"scripts/**/*.mjs\" \"{AGENTS,README}.md\" \"docs/{development,validation}/**/*.md\" \"*.{json,js,mjs,ts}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:sync": "npm run build --workspace @char2vid/studio && npm exec --workspace @char2vid/studio cap sync android",
    "android:debug": "npm run android:sync && npm run android:debug --workspace @char2vid/studio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
