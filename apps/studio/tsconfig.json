{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@char2vid/domain": ["../../packages/domain/src/contracts.ts"],
      "@char2vid/native-bridge": ["../../packages/native-bridge/src/index.ts"],
      "@char2vid/domain/*": ["../../packages/domain/src/*"],
      "@char2vid/storage-web": ["../../packages/storage-web/src/index.ts"],
      "@char2vid/storage-web/library": [
        "../../packages/storage-web/src/library.ts"
      ],
      "@char2vid/native-bridge/media-export": [
        "../../packages/native-bridge/src/media-export.ts"
      ],
      "@char2vid/storage-web/archive": [
        "../../packages/storage-web/src/archive.ts"
      ],
      "@char2vid/native-bridge/archive": [
        "../../packages/native-bridge/src/archive.ts"
      ],
      "@char2vid/native-bridge/library": [
        "../../packages/native-bridge/src/library.ts"
      ],
      "@char2vid/native-bridge/credentials": [
        "../../packages/native-bridge/src/credentials.ts"
      ],
      "@char2vid/native-bridge/jobs": [
        "../../packages/native-bridge/src/jobs.ts"
      ],
      "@char2vid/nanogpt": ["../../packages/nanogpt/src/index.ts"]
    },
    "tsBuildInfoFile": "../../node_modules/.cache/studio.tsbuildinfo"
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"],
  "references": [
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/native-bridge"
    },
    {
      "path": "../../packages/storage-web"
    },
    {
      "path": "../../packages/nanogpt"
    }
  ]
}
